/** @OnlyCurrentDoc
 * Chem Quest 3D — Google Sheets backend.
 * Bind this script to the private response spreadsheet. Run setup once.
 * Deploy Web app: execute as yourself, access Anyone. Keep ADMIN_KEY private.
 */
function setup(){
 var ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Buka Apps Script melalui Extensions pada spreadsheet.');
 var props=PropertiesService.getScriptProperties();props.setProperty('SPREADSHEET_ID',ss.getId());
 var schemas={CQ_Kelas:['id','title','phase','created_at'],CQ_Peserta:['id','sessionId','label','codeHash'],CQ_Respons:['id','participantId','stage','answers','score','submittedAt'],CQ_Referensi:['label','pre','post','origin']};
 Object.keys(schemas).forEach(function(name){var sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(schemas[name]);sh.setFrozenRows(1);sh.getRange(1,1,1,schemas[name].length).setFontWeight('bold').setBackground('#eeeeee');sh.autoResizeColumns(1,schemas[name].length);}else if(JSON.stringify(sh.getRange(1,1,1,schemas[name].length).getValues()[0])!==JSON.stringify(schemas[name]))throw new Error('Header '+name+' berbeda. Data lama tidak diubah.');});
 if(!props.getProperty('ADMIN_KEY'))props.setProperty('ADMIN_KEY',Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''));
 SpreadsheetApp.getUi().alert('Setup selesai. Simpan kunci pengelola berikut secara pribadi, lalu masukkan pada pengaturan website:\n\n'+props.getProperty('ADMIN_KEY'));
}
function doGet(){return HtmlService.createHtmlOutput('Chem Quest 3D backend aktif. Gunakan website assessment untuk mengirim jawaban.');}
function doPost(e){
 var p={},result,error;var lock=LockService.getScriptLock();
 try{p=JSON.parse(e.parameter.payload||'{}');if(!/^https:\/\/sofigf\.github\.io$/.test(p.origin||''))throw new Error('Origin website tidak diizinkan.');if(!lock.tryLock(30000))throw new Error('Server sibuk. Coba lagi.');result=handle_(p);}catch(err){error=String(err.message||err);}finally{try{lock.releaseLock();}catch(ignore){}}
 var message=JSON.stringify({channel:'CHEMQUEST',nonce:p.nonce||'',result:result||null,error:error||null}).replace(/</g,'\\u003c');
 var origin=JSON.stringify(p.origin==='https://sofigf.github.io'?p.origin:'https://sofigf.github.io');
 return HtmlService.createHtmlOutput('<!doctype html><html><body><script>window.top.postMessage('+message+','+origin+');</script></body></html>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
function sheet_(name){var id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Jalankan setup dahulu.');var sh=SpreadsheetApp.openById(id).getSheetByName(name);if(!sh)throw new Error('Tab '+name+' tidak ditemukan.');return sh;}
function rows_(name){var sh=sheet_(name);if(sh.getLastRow()<2)return[];var data=sh.getDataRange().getValues(),headers=data.shift();return data.map(function(row){var out={};headers.forEach(function(h,i){out[h]=row[i];});return out;});}
function append_(name,items){if(!items.length)return;var sh=sheet_(name);sh.getRange(sh.getLastRow()+1,1,items.length,items[0].length).setValues(items);}
function admin_(p){var key=PropertiesService.getScriptProperties().getProperty('ADMIN_KEY');if(!key||p.adminKey!==key)throw new Error('Kunci pengelola belum diisi atau tidak valid. Buka pengaturan Google Sheets.');}
function hash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s).map(function(x){return('0'+((x+256)%256).toString(16)).slice(-2);}).join('');}
function label_(n){var out='';for(var x=n+1;x>0;x=Math.floor((x-1)/26))out=String.fromCharCode(65+(x-1)%26)+out;return out;}
function summary_(rows){var pairs=rows.filter(function(r){return r.pre!==null&&r.post!==null;}),n=pairs.length,pre=n?pairs.reduce(function(s,r){return s+r.pre;},0)/n:null,post=n?pairs.reduce(function(s,r){return s+r.post;},0)/n:null,gain=n?post-pre:null;return{n:n,pre:pre,post:post,gain:gain,ngain:pre!==null&&pre<100?gain/(100-pre):null,preCount:rows.filter(function(r){return r.pre!==null;}).length,postCount:rows.filter(function(r){return r.post!==null;}).length};}
function publicQuestions_(){return QUESTIONS.map(function(q){return{id:q.id,topic:q.topic,text:q.text,options:q.options,models:q.models};});}
function handle_(p){
 if(p.action==='reference'){if(rows_('CQ_Referensi').length===0)append_('CQ_Referensi',REFERENCE.map(function(r){return[r.label,r.pre,r.post,'illustrative_reference_summary'];}));return{ok:true};}
 if(p.action==='report'){
  if(p.dataset!=='live'){var ref=rows_('CQ_Referensi').map(function(r){return{label:r.label,pre:Number(r.pre),post:Number(r.post)};});return{rows:ref,summary:summary_(ref),session:null,origin:'illustrative_reference_summary'};}
  admin_(p);var sessions=rows_('CQ_Kelas'),session=sessions.length?sessions[sessions.length-1]:null,responses=rows_('CQ_Respons');var rows=session?rows_('CQ_Peserta').filter(function(r){return r.sessionId===session.id;}).map(function(r){var pre=responses.find(function(a){return a.participantId===r.id&&a.stage==='PRE';}),post=responses.find(function(a){return a.participantId===r.id&&a.stage==='POST';});return{label:r.label,pre:pre?Number(pre.score):null,post:post?Number(post.score):null,preAt:pre?pre.submittedAt:null,postAt:post?post.submittedAt:null};}):[];return{rows:rows,summary:summary_(rows),session:session,origin:'submitted_responses'};
 }
 if(p.action==='create'){
  admin_(p);var count=Number(p.count);if(!Number.isInteger(count)||count<1||count>100)throw new Error('Jumlah peserta 1–100.');if(rows_('CQ_Kelas').some(function(s){return s.phase!=='CLOSED';}))throw new Error('Tutup kelas aktif dahulu.');var id=Utilities.getUuid(),roster=[],stored=[];
  for(var i=0;i<count;i++){var raw=Utilities.getUuid().replace(/-/g,'').slice(0,16).toUpperCase(),label=label_(i);roster.push({label:label,code:raw});stored.push([Utilities.getUuid(),id,label,hash_(raw)]);}
  append_('CQ_Kelas',[[id,String(p.title||'Kelas Hidrokarbon').slice(0,80),'PRE',new Date().toISOString()]]);append_('CQ_Peserta',stored);return{ok:true,roster:roster,sessionId:id};
 }
 if(p.action==='phase'){
  admin_(p);if(['PRE','POST','CLOSED'].indexOf(p.phase)<0)throw new Error('Tahap tidak valid.');var classes=rows_('CQ_Kelas'),idx=classes.findIndex(function(s){return s.id===p.sessionId;});if(idx<0)throw new Error('Kelas tidak ditemukan.');sheet_('CQ_Kelas').getRange(idx+2,3).setValue(p.phase);return{ok:true};
 }
 if(!/^[A-F0-9]{16}$/i.test(p.code||''))throw new Error('Kode akses harus 16 karakter.');var h=hash_(p.code.trim().toUpperCase()),student=rows_('CQ_Peserta').find(function(s){return s.codeHash===h;});if(!student)throw new Error('Kode tidak ditemukan.');var session=rows_('CQ_Kelas').find(function(s){return s.id===student.sessionId;});if(!session||session.phase==='CLOSED')throw new Error('Sesi tes ditutup.');var responses=rows_('CQ_Respons').filter(function(r){return r.participantId===student.id;}),done=responses.find(function(r){return r.stage===session.phase;});if(session.phase==='POST'&&!responses.some(function(r){return r.stage==='PRE';}))throw new Error('Selesaikan pre-test dahulu.');
 if(p.action==='start'){if(done)throw new Error('Jawaban sudah tersimpan. Tunggu tahap berikutnya.');return{label:student.label,stage:session.phase,questions:publicQuestions_()};}
 if(p.action==='submit'){
  if(p.stage!==session.phase)throw new Error('Tahap berubah. Hubungi pengelola.');if(done)return{ok:true,label:student.label,score:Number(done.score),message:'Jawaban sudah tersimpan.'};if(!Array.isArray(p.answers)||p.answers.length!==20||p.answers.some(function(a){return!Number.isInteger(a)||a<0||a>3;}))throw new Error('Lengkapi semua 20 jawaban.');var score=QUESTIONS.reduce(function(s,q,i){return s+(q.correct===p.answers[i]?5:0);},0);append_('CQ_Respons',[[Utilities.getUuid(),student.id,p.stage,JSON.stringify(p.answers),score,new Date().toISOString()]]);return{ok:true,label:student.label,score:score,message:'Jawaban berhasil disimpan ke Google Sheets.'};
 }
 throw new Error('Aksi tidak dikenal.');
}

